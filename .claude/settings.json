{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(grep -r *)",
      "Bash(grep -v *)",
      "WebSearch",
      "Bash(git diff *)",
      "Bash(git config *)",
      "Bash(echo \"EXITCODE:$?\")"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
