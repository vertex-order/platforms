{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(grep -r *)",
      "Bash(grep -v *)",
      "WebSearch",
      "Bash(git diff *)",
      "Bash(git config *)",
      "Bash(echo \"EXITCODE:$?\")"
    ],
    "additionalDirectories": ["\\tmp"]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR/scripts/capture-hook.py\" && python3 -I -X utf8 \"$CLAUDE_PROJECT_DIR/scripts/capture-hook.py\" || true"
          }
        ]
      }
    ]
  }
}
