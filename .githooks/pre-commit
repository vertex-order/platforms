#!/bin/sh
# Owned by vertex-order/kit — edit here. Vendored elsewhere via sync.toml;
# don't edit the copy there.
#
# Pre-commit: keep derived site artifacts in step with their sources.
# Pure Python, no external tools required.
set -e

root=$(git rev-parse --show-toplevel)

# 1. Restore ownership headers and design-system helmets on any staged
#    site/ file a Claude Design export may have stripped or added them to.
#    Must run before the vendored-file guard below: a stripped header or an
#    added helmet is noise the guard should never see as drift.
staged_owned=$(git diff --cached --name-only --diff-filter=ACM -- 'site/*.dc.html' 'site/_ds/**/*.css' 'site/_ds/**/*.md' 'site/support.js')
if [ -n "$staged_owned" ]; then
	python3 "$root/scripts/restore-headers.py" $staged_owned
	python3 "$root/scripts/ensure-helmets.py" $staged_owned
	git add $staged_owned
fi

# 2. Guard: refuse a commit that hand-edits a vendored file (sync.toml
#    [subscribe.*]) so it no longer matches its source. A real sync commit
#    (just sync, then commit) always matches, so it always passes.
python3 "$root/scripts/sync.py" --check-staged

# 3. Strip C2PA provenance metadata from staged PNG/SVG assets, and normalize
#    SVG empty elements to self-closing form (the icons and Claude Design's
#    exporter are inconsistent) for stable check-ins.
staged_img=$(git diff --cached --name-only --diff-filter=ACM -- '*.png' '*.svg')
if [ -n "$staged_img" ]; then
	python3 "$root/scripts/strip-c2pa.py" $staged_img
	python3 "$root/scripts/normalize-svg.py" $staged_img
	git add $staged_img
fi

# 4. Regenerate site/components.js when any *.dc.html changes.
#    bundle-components.py detects the entry page itself (any *.dc.html that
#    references components.js), so this doesn't special-case a filename.
staged_dc=$(git diff --cached --name-only --diff-filter=ACMD -- 'site/*.dc.html')
if [ -n "$staged_dc" ]; then
	python3 "$root/scripts/bundle-components.py"
	git add "$root/site/components.js"
fi

# 5. Fail a commit that leaves cross-listed duplicate game entries in
#    site/data/index.js / series-*.js out of sync with each other (same
#    dedupeKey per page.dc.html's dupGroups logic, differing
#    description/tags/rating/length/platforms/languages). Pure validator —
#    reads only, never stages anything.
staged_data=$(git diff --cached --name-only --diff-filter=ACMD -- 'site/data/*.js')
if [ -n "$staged_data" ]; then
	python3 "$root/scripts/check-dedup-drift.py"
fi

# 5b. Fail a commit whose staged site/data/*.js (or a staged
#     schemas/*.schema.json change, which could newly reject existing data)
#     doesn't match its schema -- see scripts/validate-data.py. Pure
#     validator, pure Python, no external deps -- always runs.
staged_schemas=$(git diff --cached --name-only --diff-filter=ACMD -- 'schemas/*.schema.json')
if [ -n "$staged_data" ] || [ -n "$staged_schemas" ]; then
	python3 "$root/scripts/validate-data.py"
fi

# 6. Lint staged CSS with stylelint (see .stylelintrc.cjs) -- mainly to
#    catch CSS that fails to parse at all, e.g. a comment that closes
#    earlier than intended (a literal */ inside /* ... */), which silently
#    drops whatever rule follows with no console error. Pure validator —
#    reads only, never stages anything. Runs on any *.css, including a
#    per-repo file like site/data/theme.css that sync.toml never vendors.
#
#    Node-optional, unlike every other step above: this hook is otherwise
#    pure Python, and a contributor who hasn't run `npm install` shouldn't
#    have a commit blocked over it. CI (check-css.yml) always has Node and
#    always runs this, so it's still a hard gate before merge.
staged_css=$(git diff --cached --name-only --diff-filter=ACM -- '*.css')
if [ -n "$staged_css" ]; then
	if command -v node >/dev/null 2>&1 && [ -x "$root/node_modules/.bin/stylelint" ]; then
		"$root/node_modules/.bin/stylelint" $staged_css
	else
		echo "pre-commit: skipping stylelint CSS check on: $staged_css (run 'npm install' to enable locally; CI always runs it)"
	fi
fi

# 7. Fail a commit whose staged scripts/*.py doesn't compile. Syntax-only
#    (stdlib py_compile doesn't import or run the file) -- pure Python, no
#    external tools.
staged_py=$(git diff --cached --name-only --diff-filter=ACM -- 'scripts/*.py')
if [ -n "$staged_py" ]; then
	python3 -m py_compile $staged_py
fi

# 7b. Lint + format-check staged scripts/*.py this repo actually owns
#     (scripts/sync.py --unvendored -- a staged file matching some
#     [subscribe.*] spec is byte-identical to what its owning repo's CI
#     already checked, per step 2's guard above) with ruff, a real dev
#     dependency (pyproject.toml [dependency-groups].dev) -- see
#     docs/tooling.md. `uv run` uses the locked version and reads
#     uv.toml's exclude-newer automatically.
#
#     uv-optional, same reasoning as the stylelint step above: checks for
#     an already-synced .venv/ rather than running `uv run` unconditionally,
#     since that would silently trigger a first-time `uv sync`
#     (network/download) inside a commit for a contributor who hasn't set
#     it up yet. CI (check-ruff.yml) always runs it.
if [ -n "$staged_py" ]; then
	owned_py=$(python3 "$root/scripts/sync.py" --unvendored $staged_py)
	if [ -n "$owned_py" ]; then
		if command -v uv >/dev/null 2>&1 && [ -d "$root/.venv" ]; then
			# Two statements, not `a && b` -- set -e famously does NOT
			# abort on a failing command that's the left side of `&&`
			# (its exit status counts as "already tested" by the
			# operator itself), even as a bare statement. Confirmed by
			# testing, not assumed.
			uv run ruff check $owned_py
			uv run ruff format --check $owned_py
		else
			echo "pre-commit: skipping ruff check on: $owned_py (run 'uv sync' to enable locally; CI always runs it)"
		fi
	fi
fi

# 8. Fail a commit whose staged scripts/*.js or site/data/*.js has a
#    syntax error (node --check parses without executing). site/data/*.js
#    isn't valid JSON but is valid JS -- see check-js's justfile comment.
#    Node-optional, same reasoning as the stylelint step above -- CI
#    (check-syntax.yml) always runs it.
staged_js=$(git diff --cached --name-only --diff-filter=ACM -- 'scripts/*.js' 'site/data/*.js')
if [ -n "$staged_js" ]; then
	if command -v node >/dev/null 2>&1; then
		for f in $staged_js; do node --check "$root/$f" || exit 1; done
	else
		echo "pre-commit: skipping node --check on: $staged_js (CI always runs it)"
	fi
fi

# 9. Lint staged scripts/*.js this repo actually owns (scripts/sync.py
#    --unvendored, see step 7b) with oxlint, a real devDependency -- see
#    docs/tooling.md. Node-optional, same reasoning as the stylelint step
#    above -- CI (check-oxlint.yml) always runs it.
staged_scripts_js=$(git diff --cached --name-only --diff-filter=ACM -- 'scripts/*.js')
if [ -n "$staged_scripts_js" ]; then
	owned_scripts_js=$(python3 "$root/scripts/sync.py" --unvendored $staged_scripts_js)
	if [ -n "$owned_scripts_js" ]; then
		if command -v node >/dev/null 2>&1 && [ -x "$root/node_modules/.bin/oxlint" ]; then
			"$root/node_modules/.bin/oxlint" $owned_scripts_js
		else
			echo "pre-commit: skipping oxlint on: $owned_scripts_js (run 'npm install' to enable locally; CI always runs it)"
		fi
	fi
fi

# 10. Format-check staged scripts/*.js, .github/**/*.yml, *.json, and *.css
#     with prettier, a real devDependency -- see docs/tooling.md and
#     .prettierignore for what's excluded and why. Node-optional, same
#     reasoning as the stylelint step above -- CI (check-format.yml)
#     always runs it.
staged_fmt=$(git diff --cached --name-only --diff-filter=ACM -- 'scripts/*.js' '.github/**/*.yml' '*.json' '*.css')
if [ -n "$staged_fmt" ]; then
	if command -v node >/dev/null 2>&1 && [ -x "$root/node_modules/.bin/prettier" ]; then
		"$root/node_modules/.bin/prettier" --check $staged_fmt
	else
		echo "pre-commit: skipping prettier check on: $staged_fmt (run 'npm install' to enable locally; CI always runs it)"
	fi
fi

# 11. Validate staged .github/workflows/*.yml this repo actually owns
#     (scripts/sync.py --unvendored, see step 7b) against the real GitHub
#     Actions schemas, a real devDependency (@action-validator/cli) --
#     see docs/tooling.md (not `actionlint` itself -- that npm package
#     has no CLI). Node-optional, same reasoning as the stylelint step
#     above -- CI (check-actions.yml) always runs it.
staged_workflows=$(git diff --cached --name-only --diff-filter=ACM -- '.github/workflows/*.yml')
if [ -n "$staged_workflows" ]; then
	owned_workflows=$(python3 "$root/scripts/sync.py" --unvendored $staged_workflows)
	if [ -n "$owned_workflows" ]; then
		if command -v node >/dev/null 2>&1 && [ -x "$root/node_modules/.bin/action-validator" ]; then
			for f in $owned_workflows; do
				"$root/node_modules/.bin/action-validator" "$root/$f" || exit 1
			done
		else
			echo "pre-commit: skipping action-validator on: $owned_workflows (run 'npm install' to enable locally; CI always runs it)"
		fi
	fi
fi

# 12. Lint + format-check staged *.toml this repo actually owns
#     (scripts/sync.py --unvendored -- sync.toml itself never matches,
#     every repo's own [subscribe.kit] shape genuinely differs;
#     sync.list.toml/uv.toml, where present, do) with taplo, a real
#     devDependency -- see docs/tooling.md (piped through stdin -- the
#     taplo binary doesn't discover a file path/glob argument directly,
#     see justfile's check-toml). Node-optional, same reasoning as the
#     stylelint step above -- CI (check-toml.yml) always runs it.
staged_toml=$(git diff --cached --name-only --diff-filter=ACM -- '*.toml')
if [ -n "$staged_toml" ]; then
	owned_toml=$(python3 "$root/scripts/sync.py" --unvendored $staged_toml)
	if [ -n "$owned_toml" ]; then
		if command -v node >/dev/null 2>&1 && [ -x "$root/node_modules/.bin/taplo" ]; then
			for f in $owned_toml; do
				cat "$root/$f" | "$root/node_modules/.bin/taplo" lint - || exit 1
				cat "$root/$f" | "$root/node_modules/.bin/taplo" fmt --check - || exit 1
			done
		else
			echo "pre-commit: skipping taplo on: $owned_toml (run 'npm install' to enable locally; CI always runs it)"
		fi
	fi
fi

# 13. Validate staged schemas/*.schema.json is well-formed JSON Schema
#     (2020-12), a real devDependency (ajv-cli) -- see docs/tooling.md.
#     --strict=false only silences ajv's advisory nag about this repo's
#     two union-type fields, not a real error. Skipped only if EVERY
#     schemas/*.schema.json (not just the staged ones) is vendored
#     (scripts/sync.py --unvendored) -- unlike the other steps above, this
#     always compiles the *full* glob when it runs at all, never just the
#     staged/unvendored subset: a local schema's $ref can point at a
#     vendored one (e.g. org's own schemas alongside kit's
#     common.schema.json), so dropping the vendored files would break
#     resolution rather than just skip redundant checking of them.
#     Node-optional, same reasoning as the stylelint step above -- CI
#     (check-schemas.yml) always runs it.
staged_schema_files=$(git diff --cached --name-only --diff-filter=ACM -- 'schemas/*.schema.json')
if [ -n "$staged_schema_files" ]; then
	owned_schemas=$(python3 "$root/scripts/sync.py" --unvendored schemas/*.schema.json 2>/dev/null)
	if [ -n "$owned_schemas" ]; then
		if command -v node >/dev/null 2>&1 && [ -x "$root/node_modules/.bin/ajv" ]; then
			"$root/node_modules/.bin/ajv" compile -s "schemas/*.schema.json" --spec=draft2020 --strict=false
		else
			echo "pre-commit: skipping ajv schema check on: $staged_schema_files (run 'npm install' to enable locally; CI always runs it)"
		fi
	fi
fi
