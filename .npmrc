# .npmrc — kit-owned, published via sync.toml.
#
# Refuse to install a dependency version published less than 7 days ago —
# a cooldown against supply-chain attacks (a compromised/malicious publish
# usually gets caught and unpublished/flagged within days). Applies to
# scripts/ssr-render.js's build-time deps (jsdom/react/react-dom in
# package.json) and to `just sync`/`just bundle-components`, which don't use
# npm at all but pick this file up harmlessly if that ever changes.
min-release-age=7
